{
  "manifest_version": 3,
  "name": "Haber Güvenilirlik Analizi",
  "version": "1.3.0",
  "description": "Türkçe haber sayfalarını algılar ve Turkish ELECTRA modeliyle analiz eder.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Haber Güvenilirlik Analizi"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "site_rules.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}